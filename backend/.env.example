# Config local do backend Evex apontando para uma rede Besu JÁ EXISTENTE (sem subir Hardhat/
# Blockscout locais — ver ../local-env/CLAUDE.md e ../docs/decisions.md DEC-093/DEC-094).
#
# Uso: copie para .env.local, preencha os valores, e carregue no shell antes do ./gradlew bootRun:
#   set -a && source .env.local && set +a && ./gradlew bootRun
# (Spring Boot lê variável de ambiente do processo — não existe carregamento automático de .env
# neste projeto, ver backend/README.md "Variáveis de ambiente".)

# MAINNET | TESTNET — tag aplicada a todo evento ingerido por esta instância (uma instância = uma rede).
EVEX_NETWORK=TESTNET

# Endpoint HTTP do nó Besu já existente (eth_getLogs/eth_call/etc.).
EVEX_RPC_URL=

# PAT/Bearer estático opcional — só se a rede exigir auth no RPC (DEC-094). Vazio = sem header de auth.
# Ignorado se EVEX_BLOCKCHAIN_KEYCLOAK_TOKEN_URL abaixo estiver preenchido (Keycloak tem precedência,
# DEC-095).
EVEX_BLOCKCHAIN_AUTH_TOKEN=
# EVEX_BLOCKCHAIN_AUTH_ENABLED=true

# Alternativa ao PAT acima — login via Keycloak (grant_type=password) quando a rede exige autenticação
# de verdade, não só um token fixo (ex.: rede Besu real da EBS, DEC-095). Preencha token-url pra ligar
# o modo Keycloak; deixe tudo vazio (default) pra usar o PAT estático acima (ou nenhuma auth).
EVEX_BLOCKCHAIN_KEYCLOAK_TOKEN_URL=
EVEX_BLOCKCHAIN_KEYCLOAK_CLIENT_ID=
# Opcional — só preencha se o client Keycloak for confidencial (com secret). Client público (sem
# secret, ex. "login-app" no Anbima) não precisa desta variável.
EVEX_BLOCKCHAIN_KEYCLOAK_CLIENT_SECRET=
EVEX_BLOCKCHAIN_KEYCLOAK_USERNAME=
EVEX_BLOCKCHAIN_KEYCLOAK_PASSWORD=
# EVEX_BLOCKCHAIN_KEYCLOAK_SCOPE=openid profile email
# EVEX_BLOCKCHAIN_KEYCLOAK_REFRESH_SKEW=30s

# Deixe em POLLING (default) — WEBSOCKET ainda não foi validado ao vivo (DEC-091).
# EVEX_BLOCKCHAIN_TRANSPORT=POLLING

# Blockscout não vai subir nesta instância local — deixe vazio (desabilita discovery/import de ABI).
EVEX_BLOCKSCOUT_URL=

# Conexão com o Postgres local (backend/docker-compose.yml) — default já bate, só documentado aqui
# caso você use um Postgres próprio.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/evex
# SPRING_DATASOURCE_USERNAME=evex
# SPRING_DATASOURCE_PASSWORD=evex

# Origem liberada para o frontend local via CORS — default já bate com `npm run dev` (Vite, porta 5173).
# EVEX_CORS_ALLOWED_ORIGINS=http://localhost:5173
