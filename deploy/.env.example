# Copie para deploy/.env e preencha (deploy/.env é gitignored — tem senha de banco).
#   cp deploy/.env.example deploy/.env

# --- Projeto GCP -------------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=southamerica-east1

# --- Artifact Registry (1 repositório Docker por app) -------------------------------------------
AR_BACKEND_REPO=evex-backend
AR_FRONTEND_REPO=evex-frontend

# --- Cloud Run (nome dos 2 serviços) ------------------------------------------------------------
BACKEND_SERVICE=evex-backend
FRONTEND_SERVICE=evex-frontend

# --- Rede Besu da EBS (endereço já provido — só colar aqui) -------------------------------------
EVEX_RPC_URL=
EVEX_NETWORK=TESTNET
# Vazio desliga o discovery (BlockscoutClient responde 503 sem tentar HTTP).
EVEX_BLOCKSCOUT_URL=
# Opcional — só preencher se a rede Besu de teste da EBS exigir auth no RPC (PAT/Bearer). Vazio
# preserva o comportamento sem auth de hoje (mesmo padrão de EVEX_BLOCKSCOUT_URL acima).
EVEX_BLOCKCHAIN_AUTH_TOKEN=

# --- Banco (já provisionado fora deste script, mesma org) ---------------------------------------
# JDBC URL comum — mesma env var que o backend já lê local (application.yml). Sem sidecar/proxy:
# o Cloud Run alcança o endereço via VPC Connector (variável abaixo).
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Rede: VPC Connector já existente na org, pro Cloud Run alcançar o endereço do banco ---------
# `gcloud compute networks vpc-access connectors list --region=$GCP_REGION` lista os que já existem.
VPC_CONNECTOR=
