# Copie para e2e/.env e ajuste se sua stack não estiver nas portas padrão.
# Todas têm default no código (helpers/config.ts) — só sobrescreva o que mudou.

# Frontend do Evex (npm run dev)
E2E_BASE_URL=http://localhost:5173

# Backend do Evex (./gradlew bootRun / IDE)
E2E_API_URL=http://localhost:8080

# Nó Hardhat do local-env (yarn chain --hostname 0.0.0.0)
E2E_RPC_URL=http://127.0.0.1:8545

# Blockscout do local-env (scripts/blockscout-up.sh) — só os specs de discovery precisam.
# Vazio = specs de discovery são SKIPADOS (não falham).
E2E_BLOCKSCOUT_URL=http://localhost:4001

# Postgres do Evex (local-env/docker-compose.yml). Usado só pelo reset opcional de estado.
E2E_DB_URL=postgresql://evex:evex@localhost:5432/evex

# 1 = trunca as tabelas do Evex antes da suíte (estado limpo). Requer o container do Postgres
# acessível via `docker exec`. Default 0 (specs toleram estado preexistente).
E2E_RESET_DB=0

# 1 = o global-setup dispara UM round de eventos de teste na rede (`local-env/seed/emit-events.ts`)
# antes da suíte. NÃO registra contratos/ABIs — cada spec faz isso (specs 03/04 dependem do estado
# "contrato sem ABI"). Default 0 (assume que você já rodou `local-env/scripts/up.sh`). Ver DEC-070.
E2E_RUN_SEED=0

# Base do webhook.site pro spec 07 (webhooks). Default é o serviço público. Troque por uma instância
# self-hosted se quiser. O spec 07 se skipa sozinho se essa URL estiver inacessível.
E2E_WEBHOOK_SITE_BASE=https://webhook.site

# local-env/control-panel (E17/DEC-075) — serviço da aba "Demonstração". Sobe junto no
# local-env/scripts/up.sh. Fora do ar → o spec 09 (aba Demonstração) se skipa. O webServer do
# Playwright repassa esta URL como VITE_LOCALENV_CONTROL_URL pro frontend que ele mesmo sobe.
E2E_CONTROL_PANEL_URL=http://localhost:8899
