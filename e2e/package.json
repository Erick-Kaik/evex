{
  "name": "evex-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Suíte de testes E2E (Playwright) do Evex — dirige o navegador contra o frontend real, que fala com o backend real, que indexa do local-env real. Ver e2e/CLAUDE.md.",
  "scripts": {
    "e2e": "bash scripts/run.sh",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.13.3",
    "dotenv": "^17.2.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
