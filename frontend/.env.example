VITE_API_BASE_URL=http://localhost:8080

# Opcional — só em ambiente local (E17/DEC-075/DEC-101). A aba "Demonstração" só aparece com AMBAS
# setadas: o flag abaixo é um opt-in explícito (a aba dispara scripts que fazem deploy/mint contra
# um RPC local — nunca ligar isto contra uma rede real) e a URL precisa responder ao health check.
# VITE_ENABLE_DEMO_TAB=1
# VITE_LOCALENV_CONTROL_URL=http://localhost:8899

# Modo mock: `npm run dev:mock` usa `.env.mock` (VITE_MOCK=1) — front sozinho, sem backend, com
# dados estáticos via MSW. Ver frontend/src/mocks/ e docs/guia-de-uso.md §0.1. Nunca em produção.
