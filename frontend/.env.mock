# Modo mock (`npm run dev:mock`) — front sozinho, sem backend, com dados estáticos via MSW.
# Ver src/mocks/ e docs/guia-de-uso.md.
VITE_MOCK=1

# A aba "Demonstração" aparece: o control-panel é mockado (src/mocks/handlers.ts).
VITE_LOCALENV_CONTROL_URL=http://localhost:8899

# Base da API — o MSW intercepta `*/v1/**` independente disto, mas mantém o cliente gerado feliz.
VITE_API_BASE_URL=http://localhost:8080
